;; Configuration for the documentation site, read by the jlt-commons
;; docs-engine (https://github.com/jlt-commons/docs-engine).
{;; Served at https://b12n-oss.github.io/raylib-jank-demo/, so every URL the
 ;; engine emits needs this prefix. Without it every image 404s.
 :base-path   "/raylib-jank-demo"

 :title       "raylib-jank-demo"
 :description "213 raylib examples in jank, one runnable sub-project each."

 ;; docs/demos holds a copy of every demo's recording for the gallery. The
 ;; originals sit in each sub-project's docs/demos, so a new recording goes in both.
 :asset-dirs  ["demos"]}

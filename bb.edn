;; Task runner for raylib-jank-demo: 213 raylib examples in jank, one sub-project each.
;;
;; Run these from the repo root with `bb <task>`.
;;
;;   bb info               grouped cheat-sheet, every demo included
;;   bb <demo>             run one demo, e.g. bb starfield
;;   bb run <demo>         the same, by argument
;;   bb list               flat list of demos with descriptions
;;   bb run-all [secs]     every demo for N seconds each (default 4), unattended
;;   bb check              offline gates: reader syntax, EDN, generated files, recordings
;;   bb lint               clj-kondo over every .jank source; errors fail
;;   bb lint:strict        bb lint, but warnings fail too
;;   bb doctor             lein, a jank that starts, the raylib asset submodule
;;   bb clean              remove target/ (the shared build cache) and per-demo target dirs
;;   bb gen [--check]      rebuild these per-demo tasks and the gallery from demos.edn
;;   bb record [opts]      record demo GIFs with screen-grab (maintainer-only), then sync
;;   bb sync-recordings    copy docs/demos/ recordings into each demo's own docs/demos/
;;
;; Every demo runs from its own directory with `lein run --disable-sandbox`.
;; Asset paths in the demos are relative to that directory, and they reach the
;; vendored raylib checkout at jank-raylib-sys/raylib (a git submodule). Every
;; demo builds into the shared target/, so raylib-sys is compiled natively once.
;;
;; JANK=/path/to/jank picks the jank lein-jank calls (it otherwise takes the first
;; `jank` on PATH). LEIN=/path/to/lein picks lein.
;;
;; NOTE: task bodies are EDN-parsed. No #"regex", no @deref, no #(...).
{:min-bb-version "1.3.0"
 :paths ["scripts"]
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.edn :as edn]
             [clojure.string :as str])

  :init
  (do
    ;; [{:name :category :desc :controls :ported} ...], edited by hand.
    (def demos (if (fs/exists? "demos.edn") (edn/read-string (slurp "demos.edn")) []))

    ;; A mise/asdf leiningen shim can be broken, so prefer a Homebrew install.
    (def lein (or (System/getenv "LEIN")
                  (first (filter fs/exists? ["/usr/local/bin/lein" "/opt/homebrew/bin/lein"]))
                  "lein"))

    ;; lein-jank runs the first `jank` on PATH, so JANK puts its directory first.
    (def run-env
      (if-let [j (System/getenv "JANK")]
        {"PATH" (str (fs/parent j) ":" (System/getenv "PATH"))}
        {}))

    (defn ensure-assets! []
      (when-not (fs/exists? "jank-raylib-sys/raylib/examples")
        (println "Fetching the raylib asset submodule...")
        (shell "git" "submodule" "update" "--init" "jank-raylib-sys/raylib")))

    (defn demo! [name]
      (or (first (filter (fn [d] (= name (:name d))) demos))
          (do (binding [*out* *err*]
                (println (str "No demo named " name ". `bb list` shows them all.")))
              (System/exit 1))))

    (defn run-demo
      "Run one demo from its own directory, where its asset paths resolve.
      No bwrap on macOS, so the native build runs unsandboxed."
      [name]
      (let [d (demo! name)]
        (ensure-assets!)
        (shell {:continue true :dir (:name d) :extra-env run-env} lein "run" "--disable-sandbox")))

    (defn exit-with [{:keys [exit]}]
      (when-not (zero? exit) (System/exit exit)))

    ;; clj-kondo does NOT discover .jank files: given a directory it scans for
    ;; .clj/.cljs/.cljc, finds nothing and exits 0. So the list is explicit.
    (defn jank-sources []
      (sort (map str (concat (fs/glob "common/src" "**/*.jank")
                             (mapcat (fn [d] (fs/glob (str (:name d) "/src") "**/*.jank")) demos)))))

    (defn kondo! []
      (when-not (fs/which "clj-kondo")
        (binding [*out* *err*]
          (println "bb lint needs clj-kondo on PATH: brew install borkdude/brew/clj-kondo"))
        (System/exit 1))
      (apply shell {:continue true} "clj-kondo" "--lint" (jank-sources))))

  info
  {:doc "Grouped cheat-sheet, every demo included (start here)"
   :task
   (let [esc (str (char 27) "[")
         col (fn [c s] (str esc c "m" s esc "0m"))
         hdr (fn [s] (println (str "\n" (col "35" (str "── " s " ──")))))
         row (fn [t d] (println (str "  " (col "36" (format "%-32s" (str "bb " t))) d)))]
     (println (col "1;35" "\nraylib-jank-demo: 213 raylib examples in jank, one sub-project each"))
     (hdr "Run")
     (row "<demo>" "run one demo, e.g. starfield")
     (row "run <demo>" "the same, by argument")
     (row "list" "flat list of demos with descriptions")
     (row "run-all [secs]" "every demo for N seconds each (default 4), unattended")
     (hdr "Verify")
     (row "doctor" "lein, a jank that starts, the raylib asset submodule")
     (row "check" "offline gates: reader syntax, EDN, generated files, recordings")
     (row "lint" "clj-kondo over every .jank source; errors fail (lint:strict: warnings too)")
     (hdr "Maintenance")
     (row "clean" "remove the shared build cache and per-demo target dirs")
     (row "gen [--check]" "rebuild the per-demo tasks and the gallery from demos.edn")
     (row "record [--only a,b] [--force]" "record demo GIFs with screen-grab (maintainer-only)")
     (row "sync-recordings [--check]" "copy docs/demos/ recordings into each demo's docs/demos/")
     (doseq [[category ds] (sort-by key (group-by :category demos))]
       (hdr (str category " (" (count ds) ")"))
       (doseq [d ds] (row (:name d) (or (:desc d) ""))))
     (println (str "\n" (col "2" "first run: bb doctor, then bb starfield"))))}

  list
  {:doc "Flat list of demos with descriptions"
   :task (let [w (apply max (map (fn [d] (count (:name d))) demos))]
           (doseq [d demos]
             (println (format (str "%-" w "s  %-9s  %s") (:name d) (:category d) (or (:desc d) "")))))}

  run
  {:doc "Run one demo by name: run <demo>"
   :override-builtin true
   :task (if-let [name (first *command-line-args*)]
           (exit-with (run-demo name))
           (do (println "usage: bb run <demo>   (bb list shows them)")
               (System/exit 1)))}

  run-all
  {:doc "Every demo for N seconds each (default 4), unattended; exits 1 if any fail"
   ;; The examples have no auto-quit, so this stops each one itself. Its clock
   ;; starts when raylib logs "DISPLAY: Device initialized". A demo's first
   ;; run compiles it, so it gets up to 10 minutes to open its window. A demo
   ;; still running at the end passed. One that exits non-zero, or never
   ;; opens its window, failed.
   :task (let [secs (Long/parseLong (or (first *command-line-args*) "4"))
               _ (ensure-assets!)
               run-one (fn [n]
                         (let [proc (p/process {:dir n :err :out :extra-env run-env} lein "run" "--disable-sandbox")
                               rdr (java.io.BufferedReader. (java.io.InputStreamReader. (:out proc)))
                               ready (promise)
                               ;; Keeps draining stdout after the window is up, so
                               ;; a full pipe never blocks the demo.
                               _ (future
                                   (try (loop []
                                          (when-let [l (.readLine rdr)]
                                            (when (str/includes? l "DISPLAY: Device initialized")
                                              (deliver ready true))
                                            (recur)))
                                        (catch Exception _ nil))
                                   (deliver ready false))
                               up (deref ready 600000 false)]
                           (if up
                             (do (Thread/sleep (* 1000 secs))
                                 (if (p/alive? proc)
                                   (do (p/destroy-tree proc) 0)
                                   (:exit (deref proc))))
                             (do (p/destroy-tree proc)
                                 (let [e (:exit (deref proc 5000 nil))]
                                   (if (and e (not (zero? e))) e 99))))))
               failed (vec (for [d demos
                                 :let [_ (println (str "▶ " (:name d)))
                                       exit (run-one (:name d))]
                                 :when (not (zero? exit))]
                             (str (:name d) " (exit " exit ")")))]
           (println (str "\n" (- (count demos) (count failed)) "/" (count demos) " demos ran without failing"))
           (when (seq failed)
             (println (str "failed: " (str/join ", " failed)))
             (System/exit 1)))}

  check
  {:doc "Offline gates: reader syntax, EDN, generated files, recordings (compiles nothing)"
   :task (let [codes (for [cmd [["bb" "scripts/check.clj"] ["bb" "gen" "--check"] ["bb" "sync-recordings" "--check"]]]
                       (:exit (apply shell {:continue true} cmd)))]
           (when (some (fn [c] (not (zero? c))) codes) (System/exit 1)))}

  lint
  {:doc "clj-kondo over every .jank source: warnings are reported, errors fail"
   ;; clj-kondo exits 2 for warnings and 3 for errors.
   :task (let [{:keys [exit]} (kondo!)]
           (cond (zero? exit) (println "OK clj-kondo: no errors or warnings")
                 (= 2 exit) (println "clj-kondo: warnings above, not failing; the gate is errors")
                 :else (System/exit exit)))}

  lint:strict
  {:doc "bb lint, but exit non-zero on any warning or error"
   :task (exit-with (kondo!))}

  doctor
  {:doc "Check lein, a jank that starts, and the raylib asset submodule"
   :task (let [jank (or (System/getenv "JANK") (some-> (fs/which "jank") str))
               ;; A jank linked against an LLVM Homebrew has since replaced dies in
               ;; dyld before doing anything. Any other reply means it started.
               jank-ok (when jank
                         (let [{:keys [out err]} (shell {:out :string :err :string :continue true} jank "help")]
                           (not (re-find (re-pattern "dyld|Symbol not found|Library not loaded") (str out err)))))
               checks [["lein" (or (System/getenv "LEIN") (some fs/exists? ["/usr/local/bin/lein" "/opt/homebrew/bin/lein"]) (fs/which "lein"))
                        "brew install leiningen"]
                       [(str "jank starts (" (or jank "none on PATH") ")") jank-ok
                        "brew install jank, or point JANK at a working jank; a source build must match its LLVM"]
                       ["raylib asset submodule (jank-raylib-sys/raylib)" (fs/exists? "jank-raylib-sys/raylib/examples")
                        "git submodule update --init jank-raylib-sys/raylib"]
                       ["demos.edn" (fs/exists? "demos.edn") "restore it from git"]]]
           (doseq [[what ok fix] checks]
             (println (str (if ok "  ok    " "  MISSING ") what (when-not ok (str "  -> " fix)))))
           (when-not (every? second checks) (System/exit 1)))}

  clean
  {:doc "Remove target/ (the shared build cache) and every per-demo target/"
   :task (doseq [d (cons "target" (map (fn [d] (str (:name d) "/target")) demos))
                 :when (fs/exists? d)]
           (fs/delete-tree d)
           (println "removed" d))}

  demos:examples
  {:doc "Print every demo as EDN for screen-grab's :examples-cmd"
   ;; screen-grab's working directory is per manifest, not per item, so each
   ;; item cds into its demo. rlgl-compute is out of scope on macOS, as before.
   :task (prn (vec (for [d demos
                         :let [n (:name d)]
                         :when (not= n "rlgl-compute")]
                     {:id n
                      :group (:category d)
                      :desc (:desc d)
                      :src (str n "/src/net/b12n/raylib_jnk/scenes/" (str/replace n "-" "_") ".jank")
                      :run (str "sh -c 'cd " n " && exec " lein " run --disable-sandbox'")})))}

  record
  {:doc "Record demo GIFs into docs/demos/ (screen-grab), then sync each demo's copy and the gallery"
   :task (if-not (fs/which "screen-grab")
           (binding [*out* *err*]
             (println "bb record needs the `screen-grab` capture CLI on your PATH.")
             (println "That tool is internal and not publicly released yet, so this task is")
             (println "maintainer-only. Every recording is committed, so you never need it to")
             (println "view the demos.")
             (System/exit 1))
           (let [{:keys [exit]} (apply shell {:continue true :extra-env run-env}
                                       "screen-grab" "record"
                                       "--manifest" "scripts/demo_manifest.edn"
                                       *command-line-args*)]
             ;; Sync even after a partial failure: the items that did record
             ;; should reach their demo's folder and the gallery.
             (when-not (some #{"--dry-run" "--list"} *command-line-args*)
               (shell "bb" "sync-recordings")
               (shell "bb" "gen"))
             (when-not (zero? exit) (System/exit exit))))}

  sync-recordings
  {:doc "Copy docs/demos/ recordings into each demo's own docs/demos/: sync-recordings [--check]"
   :requires ([sync-recordings])
   :task (apply sync-recordings/-main *command-line-args*)}

  gen
  {:doc "Rebuild the per-demo tasks and the gallery from demos.edn: gen [--check]"
   :requires ([gen])
   :task (apply gen/-main *command-line-args*)}

